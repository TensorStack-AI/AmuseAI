<CommonControls:DialogControl x:Class="Amuse.App.Dialogs.ModelInformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        xmlns:Common="clr-namespace:Amuse.App.Common"
        mc:Ignorable="d"
        MinWidth="800"
        MaxWidth="800"
        Title="Download Information"
        Icon="/Images/Icon.ico"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ModelInformationDialog}}}" Margin="15, 15, 15, 10">

        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <TextBlock />
                <Button Content="Close" Command="{Binding CloseCommand}" Width="100" IsDefault="True"/>
            </UniformGrid>
            <TextBlock />
        </DockPanel>

        <DockPanel Margin="0,0,0,0" >
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                <TextBlock Text="{Binding DownloadModel.Name}" FontSize="16" FontWeight="DemiBold" />
                <CommonControls:HyperlinkControl Link="{Binding DownloadModel.Link}" Label="{Binding DownloadModel.Link}" FontSize="13" Foreground="DeepSkyBlue" Margin="1,0,0,0"/>
            </StackPanel>

            <ContentControl Content="{Binding DownloadModel}" Foreground="{StaticResource DefaultForeground}" >
                <ContentControl.Resources>
                    <local:DictionaryLookupMultiConverter x:Key="DictionaryLookupMultiConverter" />

                    <!--CheckpointComponent-->
                    <DataTemplate DataType="{x:Type Common:CheckpointComponent}">
                        <GroupBox Header="{Binding Name}" Margin="0,0,0,6">
                            <StackPanel Margin="6">
                                <StackPanel Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Component}">
                                    <ItemsControl>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding  Converter="{StaticResource DictionaryLookupMultiConverter}">
                                                <Binding Path="Path" />
                                                <Binding Path="ComponentMap" RelativeSource="{RelativeSource AncestorType={x:Type local:ModelInformationDialog}}" />
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DownloadFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>

                    <!--DiffusionModel-->
                    <DataTemplate DataType="{x:Type Common:DiffusionModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint.TextEncoder}" Visibility="{Binding Checkpoint.TextEncoder, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.TextEncoder2}" Visibility="{Binding Checkpoint.TextEncoder2, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.TextEncoder3}" Visibility="{Binding Checkpoint.TextEncoder3, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.Unet}" Visibility="{Binding Checkpoint.Unet, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.Transformer}" Visibility="{Binding Checkpoint.Transformer, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.Transformer2}" Visibility="{Binding Checkpoint.Transformer2, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.Vae}" Visibility="{Binding Checkpoint.Vae, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.AudioVae}" Visibility="{Binding Checkpoint.AudioVae, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.Vocoder}" Visibility="{Binding Checkpoint.Vocoder, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.Connectors}" Visibility="{Binding Checkpoint.Connectors, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.LatentUpsampler}" Visibility="{Binding Checkpoint.LatentUpsampler, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.LatentUpsamplerTemporal}" Visibility="{Binding Checkpoint.LatentUpsamplerTemporal, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.ConditionEncoder}" Visibility="{Binding Checkpoint.ConditionEncoder, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.AudioTokenizer}" Visibility="{Binding Checkpoint.AudioTokenizer, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.AudioDetokenizer}" Visibility="{Binding Checkpoint.AudioDetokenizer, Converter={StaticResource NullVisibilityConverter}}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!--LanguageModel-->
                    <DataTemplate DataType="{x:Type Common:LanguageModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint.TextModel}" Visibility="{Binding Checkpoint.TextModel, Converter={StaticResource NullVisibilityConverter}}"/>
                                <ContentPresenter Content="{Binding Checkpoint.TextModel2}" Visibility="{Binding Checkpoint.TextModel2, Converter={StaticResource NullVisibilityConverter}}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!--ComponentModel-->
                    <DataTemplate DataType="{x:Type Common:ComponentModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!--LoraAdapterModel-->
                    <DataTemplate DataType="{x:Type Common:LoraAdapterModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!--ControlNetModel-->
                    <DataTemplate DataType="{x:Type Common:ControlNetModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!--UpscaleModel-->
                    <DataTemplate DataType="{x:Type Common:UpscaleModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!--ExtractModel-->
                    <DataTemplate DataType="{x:Type Common:ExtractModel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter Content="{Binding Checkpoint}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                </ContentControl.Resources>
            </ContentControl>
        </DockPanel>
    </DockPanel>
</CommonControls:DialogControl>